{
  "name": "@grafikr/shopify-app-session-storage-prisma",
  "version": "1.0.0-test.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "release": "release-it",
    "release:test": "release-it --preRelease=test"
  },
  "release-it": {
    "git": {
      "commitMessage": "Release ${version}",
      "tagName": "v${version}",
      "requireBranch": false
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": true
    }
  },
  "devDependencies": {
    "@shopify/shopify-api": "^15.1.1",
    "@shopify/shopify-app-session-storage": "^7.0.3",
    "@types/bun": "latest",
    "release-it": "^21.1.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@shopify/shopify-api": "^15.0.0",
    "@shopify/shopify-app-session-storage": "^7.0.0"
  }
}
